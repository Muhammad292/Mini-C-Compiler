Grammar

    0 $accept: program $end

    1 program: decl_list

    2 decl_list: decl_list decl
    3          | decl

    4 decl: type ID ';'
    5     | func_def
    6     | error ';'

    7 type: TOK_INT
    8     | TOK_FLOAT
    9     | TOK_BOOL

   10 $@1: ε

   11 func_def: type ID '(' param_list_opt ')' $@1 block

   12 param_list_opt: ε
   13               | param_list

   14 param_list: param
   15           | param_list ',' param

   16 param: type ID

   17 block: '{' stmt_list '}'

   18 stmt_list: stmt_list stmt
   19          | ε

   20 stmt: type ID ';'
   21     | assign_stmt
   22     | input_stmt
   23     | output_stmt
   24     | if_stmt
   25     | while_stmt
   26     | for_stmt
   27     | return_stmt
   28     | block_stmt
   29     | ';'
   30     | error ';'

   31 $@2: ε

   32 block_stmt: '{' $@2 stmt_list '}'

   33 assign_stmt: ID ASSIGN expr ';'

   34 input_stmt: INPUT '(' in_list ')' ';'

   35 in_list: ID
   36        | in_list ',' ID

   37 output_stmt: OUTPUT '(' out_list ')' ';'

   38 out_list: out_item
   39         | out_list ',' out_item

   40 out_item: STRING
   41         | expr

   42 if_stmt: IF '(' expr ')' stmt
   43        | IF '(' expr ')' stmt ELSE stmt

   44 while_stmt: WHILE '(' expr ')' stmt

   45 for_stmt: FOR '(' for_init ';' expr ';' for_update ')' stmt

   46 for_init: assign_stmt_no_semi
   47         | type ID ASSIGN expr
   48         | ε

   49 for_update: assign_stmt_no_semi
   50           | ε

   51 assign_stmt_no_semi: ID ASSIGN expr

   52 return_stmt: RETURN expr ';'
   53            | RETURN ';'

   54 expr: INT_CONST
   55     | FLOAT_CONST
   56     | BOOL_CONST
   57     | ID
   58     | expr ADD expr
   59     | expr SUB expr
   60     | expr MUL expr
   61     | expr DIV expr
   62     | expr EQ expr
   63     | expr NE expr
   64     | expr LE expr
   65     | expr GE expr
   66     | expr LT expr
   67     | expr GT expr
   68     | expr LAND expr
   69     | expr LOR expr
   70     | LNOT expr
   71     | '(' expr ')'


